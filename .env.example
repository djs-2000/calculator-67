# Server runtime port (AI Studio / Node server)
PORT=3000
NODE_ENV=development

# Public Supabase client credentials (safe for browser / Cloudflare Pages)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set to "supabase" on Cloudflare Pages static deployment to call Edge Functions directly.
# Leave as "api" (default) when running with the Express backend server.
VITE_BACKEND_MODE=api

# Server-only Supabase credentials (NEVER expose in frontend or VITE_* variables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional HMAC pepper for hashing access codes and session tokens server-side
ACCESS_TOKEN_SECRET=replace-with-random-32-byte-secret
